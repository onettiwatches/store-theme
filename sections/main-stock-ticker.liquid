<style>
  #st-{{ section.id }} {
    background-color: #0a0a0a;
    color: rgb(var(--color-foreground));
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 4%, black 96%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 4%, black 96%, transparent 100%);
  }

  #st-{{ section.id }} .st-track {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    padding: 0.6rem 0;
    width: max-content;
    animation: st-scroll-{{ section.id }} 40s linear infinite;
    will-change: transform;
  }

  #st-{{ section.id }} .st-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body-family);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(var(--color-foreground), 0.85);
  }

  #st-{{ section.id }} .st-dot {
    width: 4px;
    height: 4px;
    background: rgb(var(--color-base-accent-2));
    border-radius: 50%;
    flex-shrink: 0;
  }

  #st-{{ section.id }} .st-item a {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s var(--ease-out-quart);
  }

  #st-{{ section.id }} .st-item a:hover,
  #st-{{ section.id }} .st-item a:focus-visible {
    color: rgb(var(--color-base-accent-2));
  }

  #st-{{ section.id }}:hover .st-track,
  #st-{{ section.id }}:focus-within .st-track {
    animation-play-state: paused;
  }

  @keyframes st-scroll-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #st-{{ section.id }} .st-track {
      animation: none;
      transform: none;
    }
  }
</style>

{%- if section.blocks.size > 0 -%}
  <section
    id="st-{{ section.id }}"
    class="st-section"
    aria-label="Información destacada"
    role="region"
  >
    <div class="st-track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' and block.settings.text != blank -%}
          <span class="st-item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
            <span class="st-dot" aria-hidden="true"></span>
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<script>
(function () {
  const SECTION_ID     = {{ section.id | json }};
  const SPEED_PX_PER_S = {{ section.settings.speed | times: 1.0 }};

  function init() {
    const container = document.getElementById('st-' + SECTION_ID);
    if (!container) return;

    const track = container.querySelector('.st-track');
    if (!track) return;

    const originals = Array.from(track.children);
    if (originals.length === 0) return;

    track.innerHTML = '';
    originals.forEach(c => track.appendChild(c));

    const vw = container.offsetWidth;

    let safety = 0;
    while (track.scrollWidth < vw * 2 && safety < 6) {
      const current = Array.from(track.children);
      current.forEach(c => track.appendChild(c.cloneNode(true)));
      safety++;
    }

    const halfWidth = track.scrollWidth / 2;
    if (halfWidth > 0) {
      const duration = halfWidth / SPEED_PX_PER_S;
      track.style.animationDuration = duration + 's';
    }
  }

  function schedule() {
    requestAnimationFrame(init);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', schedule);
  } else {
    schedule();
  }

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(schedule, 150);
  });
})();
</script>

{% schema %}
{
  "name": "Stock ticker",
  "tag": "section",
  "class": "st-section",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 120,
      "step": 5,
      "label": "Velocidad (px/seg)",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Mensaje",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratis en pedidos +$500"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Stock ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Envío gratis en pedidos +$500" } },
        { "type": "item", "settings": { "text": "Garantía internacional de 2 años" } },
        { "type": "item", "settings": { "text": "Producción artesanal bajo pedido" } }
      ]
    }
  ]
}
{% endschema %}