<style>
  :root {
    --slide-w: 280px;
    --gap: 20px;
    --speed: 400ms;
    --easing: cubic-bezier(0.22, 1, 0.36, 1);
    --scale: 1.2;
  }

  #pc-{{ section.id }} {
    --pc-bg:                  {{ settings.colors_background_1 }};
    --pc-text:                {{ settings.colors_text }};
    --pc-accent:              {{ settings.colors_accent_2 }};
    --pc-btn-txt:             {{ settings.colors_solid_button_labels }};

    background-color: var(--pc-bg);
    padding: var(--space-7) 0 var(--space-8);
    overflow: hidden;
    position: relative;
  }

  #pc-{{ section.id }} .pc-header {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    margin-bottom: var(--space-6);
    padding: 0 var(--space-4);
    position: relative;
  }

  #pc-{{ section.id }} .pc-title {
    margin: 0;
    line-height: var(--lh-tight);
    color: var(--pc-text);
    font-family: var(--font-heading-family);
  }

  #pc-{{ section.id }} .pc-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: var(--space-3);
  }

  #pc-{{ section.id }} .pc-nav-btn {
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--pc-accent) 40%, transparent);
    background: transparent;
    color: var(--pc-text);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    padding: 0;
  }

  #pc-{{ section.id }} .pc-nav-btn:hover {
    background: var(--pc-accent);
    color: var(--pc-btn-txt);
    border-color: var(--pc-accent);
  }

  #pc-{{ section.id }} .pc-nav-btn svg {
    width: 1.5rem; height: 1.5rem;
    stroke: currentColor; stroke-width: 1.8; fill: none;
    pointer-events: none;
  }

  #pc-{{ section.id }} .pc-viewport {
    overflow: hidden;
    width: 100%;
    display: flex;
    align-items: center;
    height: 48rem;
  }

  #pc-{{ section.id }} .pc-track {
    display: flex;
    will-change: transform;
    transition: transform var(--speed) var(--easing);
    align-items: center;
    height: 100%;
  }

  #pc-{{ section.id }} .pc-card {
    flex: 0 0 var(--slide-w);
    margin: 0 var(--gap);
    cursor: pointer;
    border-radius: var(--radius-md);
    background: var(--pc-bg);
    border: 1px solid rgba(var(--pc-text), 0.08);
    transition: all var(--speed) var(--easing);
    padding-top: var(--space-3);
  }

  #pc-{{ section.id }} .pc-card.center {
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    position: relative;
    transform: scale(var(--scale));
  }

  #pc-{{ section.id }} .pc-img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  #pc-{{ section.id }} .pc-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    user-select: none;
    transition: transform calc(var(--speed) * 0.9) var(--easing);
  }

  #pc-{{ section.id }} .pc-card:hover .pc-img-wrap img {
    transform: scale(1.05);
  }

  #pc-{{ section.id }} .pc-card.center .pc-img-wrap img {
    transform: scale(1.04);
  }
  #pc-{{ section.id }} .pc-card.center:hover .pc-img-wrap img {
    transform: scale(1.08);
  }

  #pc-{{ section.id }} .pc-card-body {
    padding: var(--space-4);
    text-align: center;
  }

  #pc-{{ section.id }} a.pc-card,
  #pc-{{ section.id }} a.pc-card .pc-name {
    color: var(--pc-text);
    text-decoration: none !important;
  }

  #pc-{{ section.id }} a.pc-card:hover .pc-name,
  #pc-{{ section.id }} a.pc-card:focus-visible .pc-name {
    color: var(--pc-accent);
  }

  #pc-{{ section.id }} .pc-name {
    margin: 0 0 var(--space-1);
    font-family: var(--font-heading-family);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--pc-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: var(--lh-normal);
    transition: color 0.3s var(--ease-out-quart);
  }
  #pc-{{ section.id }} .pc-price,
  #pc-{{ section.id }} .pc-price * {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    font-size: 1.6rem;
    letter-spacing: 0.1rem;
    line-height: calc(1 + 0.5 / var(--font-body-scale));
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }
  #pc-{{ section.id }} .pc-price {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  #pc-{{ section.id }} .pc-price-compare {
    text-decoration: line-through !important;
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  #pc-{{ section.id }} .pc-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 36px;
  }

  #pc-{{ section.id }} .pc-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--pc-text) 20%, transparent);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  #pc-{{ section.id }} .pc-dot.active {
    background: var(--pc-accent);
    transform: scale(1.4);
  }
</style>

<section id="pc-{{ section.id }}">
  <div class="pc-header">
    <h2 class="pc-title">{{ section.settings.heading }}</h2>
    <div class="pc-nav">
      <button class="pc-nav-btn" id="pc-prev-{{ section.id }}" aria-label="Anterior">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="pc-nav-btn" id="pc-next-{{ section.id }}" aria-label="Siguiente">
        <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
      </button>
    </div>
  </div>

  <div class="pc-viewport" id="pc-vp-{{ section.id }}">
    <div class="pc-track" id="pc-track-{{ section.id }}"></div>
  </div>

  <div class="pc-dots" id="pc-dots-{{ section.id }}"></div>
</section>

{%- assign source_collection = collections[section.settings.source_collection] -%}

<script>
(function () {
  const rawItems = [
    {%- if source_collection != blank and source_collection.products.size > 0 -%}
      {%- for product in source_collection.products limit: section.settings.products_limit -%}
        {
          url:   {{ product.url | json }},
          title: {{ product.title | json }},
          img:   {{ product.featured_image | default: product.images.first | image_url: width: 600 | json }},
          alt:   {{ product.featured_image.alt | default: product.title | json }},
          price: {{ product.price | money | json }},
          compare: {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  ];

  if (rawItems.length === 0) {
    document.getElementById('pc-vp-{{ section.id }}').style.display = 'none';
    document.getElementById('pc-dots-{{ section.id }}').style.display = 'none';
    return;
  }

  const SLIDE_W       = 280;
  const GAP           = 20;
  const SIZE          = SLIDE_W + GAP * 2;
  const TARGET_SLIDES = 15;
  const AUTOPLAY_ON           = {{ section.settings.autoplay | json }};
  const AUTOPLAY_MS           = {{ section.settings.autoplay_speed }};
  const AUTOPLAY_COOLDOWN_MS  = AUTOPLAY_MS * 5;
  const SECTION_ID            = {{ section.id | json }};

  const track       = document.getElementById('pc-track-' + SECTION_ID);
  const viewport    = document.getElementById('pc-vp-' + SECTION_ID);
  const prevBtn     = document.getElementById('pc-prev-' + SECTION_ID);
  const nextBtn     = document.getElementById('pc-next-' + SECTION_ID);
  const dotsWrap    = document.getElementById('pc-dots-' + SECTION_ID);

  let centerIndex          = 0;
  let isMoving             = false;
  let autoplayEnabled      = false;
  let autoplayId           = null;
  let currentVirtual       = 0;
  let lastManualNavigation = 0;

  const dots = rawItems.map((_, i) => {
    const btn = document.createElement('button');
    btn.className = 'pc-dot';
    btn.setAttribute('aria-label', 'Ir al producto ' + (i + 1));
    btn.addEventListener('click', () => {
      recordManualNavigation();
      goTo(i);
    });
    dotsWrap.appendChild(btn);
    return btn;
  });

  function updateDots(virtualIdx) {
    const realIdx = ((virtualIdx % rawItems.length) + rawItems.length) % rawItems.length;
    dots.forEach((d, i) => d.classList.toggle('active', i === realIdx));
  }

  function createSlide(virtualIndex) {
    const n   = ((virtualIndex % rawItems.length) + rawItems.length) % rawItems.length;
    const c   = rawItems[n];

    const div = document.createElement('a');
    div.href = c.url;
    div.className     = 'pc-card';
    div.dataset.index = virtualIndex;
    div.dataset.real  = n;

    div.innerHTML = `
      <div class="pc-img-wrap">
        <img src="${c.img}" alt="${c.alt}" loading="lazy" width="600" height="600" draggable="false" ondragstart="return false;">
      </div>
      <div class="pc-card-body">
        <p class="pc-name">${c.title}</p>
        <p class="pc-price">${c.compare ? `<s class="pc-price-compare">${c.compare}</s>` : ''}<span class="pc-price-current">${c.price}</span></p>
      </div>
    `;

    return div;
  }

  function updateTransform() {
    const vw = viewport.offsetWidth;
    const centerOffset = vw / 2 - SLIDE_W / 2 - GAP;
    const x = centerOffset - centerIndex * SIZE;
    track.style.transform = `translate3d(${x}px, 0, 0)`;
  }

  function highlightCenter() {
    Array.from(track.children).forEach(s => s.classList.remove('center'));
    const c = track.children[centerIndex];
    if (c) {
      c.classList.add('center');
      currentVirtual = parseInt(c.dataset.index);
      updateDots(currentVirtual);
    }
  }

  function maintainBuffer() {
    const total    = track.children.length;
    if (!total) return;
    const BUFFER_EDGE = Math.floor(TARGET_SLIDES / 3);

    const minIndex = BUFFER_EDGE;
    const maxIndex = total - BUFFER_EDGE - 1;

    if (centerIndex < minIndex) {
      const needed = minIndex - centerIndex;
      for (let i = 0; i < needed; i++) {
        const firstV = parseInt(track.firstElementChild.dataset.index);
        track.prepend(createSlide(firstV - 1));
        centerIndex++;
      }
    }

    if (centerIndex > maxIndex) {
      const needed = centerIndex - maxIndex;
      for (let i = 0; i < needed; i++) {
        const lastV = parseInt(track.lastElementChild.dataset.index);
        track.append(createSlide(lastV + 1));
      }
    }

    while (track.children.length > TARGET_SLIDES) {
      const firstV  = parseInt(track.firstElementChild.dataset.index);
      const lastV   = parseInt(track.lastElementChild.dataset.index);
      const centerV = parseInt(track.children[centerIndex].dataset.index);

      if (centerV - firstV > lastV - centerV) {
        track.removeChild(track.firstElementChild);
        centerIndex--;
      } else {
        track.removeChild(track.lastElementChild);
      }
    }
  }

  function move(dir) {
    if (isMoving) return;
    isMoving = true;

    centerIndex += dir;
    updateTransform();
    highlightCenter();

    const onEnd = () => {
      track.removeEventListener('transitionend', onEnd);
      track.style.transition = 'none';
      maintainBuffer();
      updateTransform();
      highlightCenter();
      void track.offsetHeight;
      track.style.transition = '';
      setTimeout(() => {
        isMoving = false;
      }, 300);
    };

    track.addEventListener('transitionend', onEnd, { once: true });
  }

  function recordManualNavigation() {
    lastManualNavigation = Date.now();
  }

  function goTo(realIndex) {
    if (isMoving) return;
    const currentReal = ((currentVirtual % rawItems.length) + rawItems.length) % rawItems.length;
    let diff = realIndex - currentReal;
    if (diff > rawItems.length / 2)  diff -= rawItems.length;
    if (diff < -rawItems.length / 2) diff += rawItems.length;
    if (diff === 0) return;
    move(diff);
  }

  function startAutoplay() {
    if (autoplayId) clearInterval(autoplayId);
    autoplayId = setInterval(() => {
      if (Date.now() - lastManualNavigation < AUTOPLAY_COOLDOWN_MS) return;
      if (!isMoving) move(1);
    }, AUTOPLAY_MS);
  }

  function stopAutoplay() {
    if (autoplayId) { clearInterval(autoplayId); autoplayId = null; }
  }

  function init() {
    const half = Math.floor(TARGET_SLIDES / 2);
    for (let i = -half; i <= half; i++) track.appendChild(createSlide(i));
    centerIndex = half;
    updateTransform();
    highlightCenter();

    if (AUTOPLAY_ON) {
      autoplayEnabled = true;
      startAutoplay();
    }
  }

  prevBtn.addEventListener('click', () => {
    recordManualNavigation();
    move(-1);
  });
  nextBtn.addEventListener('click', () => {
    recordManualNavigation();
    move(1);
  });

  viewport.addEventListener('mouseenter', stopAutoplay);
  viewport.addEventListener('mouseleave', () => {
    if (autoplayEnabled) startAutoplay();
  });

  window.addEventListener('resize', () => {
    track.style.transition = 'none';
    updateTransform();
    void track.offsetHeight;
    track.style.transition = '';
  });

  window.addEventListener('beforeunload', stopAutoplay);

  init();
})();
</script>

{% schema %}
{
  "name": "Products Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Productos destacados"
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Colección de origen"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Número de productos",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproducción automática",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "label": "Velocidad autoplay (ms)",
      "default": 4500
    }
  ],
  "presets": [
    {
      "name": "Products Carousel",
      "category": "Productos"
    }
  ]
}
{% endschema %}
