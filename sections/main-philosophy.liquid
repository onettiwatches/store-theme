<style>
  #filosofia-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #filosofia-{{ section.id }} .ph-title-wrapper {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  #filosofia-{{ section.id }} .ph-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "img txt";
    gap: var(--space-6);
    align-items: center;
    max-width: var(--page-width, 1600px);
    margin: 0 auto var(--space-8);
    padding: 0 var(--space-4);
  }
  #filosofia-{{ section.id }} .ph-block:last-child {
    margin-bottom: 0;
  }
  #filosofia-{{ section.id }} .ph-block--left {
    grid-template-areas: "txt img";
  }
  #filosofia-{{ section.id }} .ph-block--right {
    grid-template-areas: "img txt";
  }
  #filosofia-{{ section.id }} .ph-block-image {
    grid-area: img;
  }
  #filosofia-{{ section.id }} .ph-block-text {
    grid-area: txt;
  }
  @media (max-width: 989px) {
    #filosofia-{{ section.id }} .ph-block,
    #filosofia-{{ section.id }} .ph-block--left,
    #filosofia-{{ section.id }} .ph-block--right {
      grid-template-columns: 1fr;
      grid-template-areas: "img" "txt";
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }
  }

  #filosofia-{{ section.id }} .ph-block-image {
    width: 100%;
    height: 100%;
    max-width: 52rem;
    max-height: 45rem;
    overflow: hidden;
    border-radius: var(--radius-md);
    justify-self: center;
  }
  @media (max-width: 989px) {
    #filosofia-{{ section.id }} .ph-block-image {
      max-width: 40rem;
      justify-self: center;
    }
  }
  #filosofia-{{ section.id }} .ph-block-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.6s var(--ease-out-quart);
  }
  #filosofia-{{ section.id }} .ph-block:hover .ph-block-image img {
    transform: scale(1.04);
  }
  #filosofia-{{ section.id }} .ph-block-image--empty {
    aspect-ratio: 4 / 3;
    border: 1px dashed rgba(var(--color-foreground), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #filosofia-{{ section.id }} .ph-block-image--empty span {
    color: rgba(var(--color-foreground), 0.4);
    font-family: var(--font-body-family);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #filosofia-{{ section.id }} .ph-block-text {
    grid-area: txt;
    text-align: left;
  }
  #filosofia-{{ section.id }} .ph-block-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  #filosofia-{{ section.id }} .ph-block-body {
    font-family: var(--font-body-family);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: rgba(var(--color-foreground), 0.78);
    margin: 0;
  }
  #filosofia-{{ section.id }} .ph-block-body p {
    margin: 0 0 var(--space-3);
  }
  #filosofia-{{ section.id }} .ph-block-body p:last-child {
    margin-bottom: 0;
  }

  #filosofia-{{ section.id }} .ph-holo-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "txt card";
    gap: var(--space-6);
    align-items: center;
    max-width: var(--page-width, 1600px);
    margin: 0 auto var(--space-8);
    padding: 0 var(--space-4);
  }
  #filosofia-{{ section.id }} .ph-holo-block:last-child {
    margin-bottom: 0;
  }
  #filosofia-{{ section.id }} .ph-holo-block--right {
    grid-template-areas: "card txt";
  }
  #filosofia-{{ section.id }} .ph-holo-text {
    grid-area: txt;
    text-align: left;
  }
  #filosofia-{{ section.id }} .ph-holo-card-wrap {
    grid-area: card;
    perspective: 1000px;
    width: 100%;
    max-width: 52rem;
    justify-self: center;
  }
  @media (max-width: 989px) {
    #filosofia-{{ section.id }} .ph-holo-block,
    #filosofia-{{ section.id }} .ph-holo-block--right {
      grid-template-columns: 1fr;
      grid-template-areas: "card" "txt";
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }
  }

  #filosofia-{{ section.id }} .ph-holo-card {
    position: relative;
    width: 100%;
    max-width: 52rem;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transition: transform 0.15s var(--ease-out-quart);
    will-change: transform;
    cursor: pointer;
    overflow: hidden;
    --foil-x: 50%;
    --foil-y: 50%;
  }
  #filosofia-{{ section.id }} .ph-holo-image-wrap {
    position: relative;
    z-index: 0;
    display: block;
    line-height: 0;
  }
  #filosofia-{{ section.id }} .ph-holo-image-wrap img {
    display: block;
    width: 100%;
    max-width: 52rem;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    -webkit-user-select: none;
  }
  #filosofia-{{ section.id }} .ph-holo-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    z-index: 1;
    background-image: linear-gradient(
      115deg,
      transparent 22%,
      rgba(var(--color-base-accent-2), 0.18) 42%,
      rgba(255, 255, 255, 0.16) 50%,
      rgba(var(--color-base-accent-2), 0.12) 58%,
      transparent 78%
    );
    background-size: 240% 240%;
    background-position: var(--foil-x) var(--foil-y);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-quart);
  }
  @media (hover: hover) and (pointer: fine) {
    #filosofia-{{ section.id }} .ph-holo-card:hover::before,
    #filosofia-{{ section.id }} .ph-holo-card:focus-visible::before {
      opacity: 1;
    }
  }
  #filosofia-{{ section.id }} .ph-holo-card:focus-visible {
    outline: 0.2rem solid rgba(var(--color-base-accent-2), 0.7);
    outline-offset: 0.3rem;
  }

  #filosofia-{{ section.id }} .ph-holo-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  #filosofia-{{ section.id }} .ph-holo-body {
    font-family: var(--font-body-family);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: rgba(var(--color-foreground), 0.78);
    margin: 0;
  }
  #filosofia-{{ section.id }} .ph-holo-body p {
    margin: 0 0 var(--space-3);
  }
  #filosofia-{{ section.id }} .ph-holo-body p:last-child {
    margin-bottom: 0;
  }
</style>

<section
  id="filosofia-{{ section.id }}"
  class="section color-background-1"
>
  <div class="ph-title-wrapper page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="title">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'holo_card' -%}
        {%- assign holo_pos = '' -%}
        {%- if block.settings.position == 'right' -%}
          {%- assign holo_pos = 'ph-holo-block--right' -%}
        {%- endif -%}
        <div class="ph-holo-block {{ holo_pos }}" {{ block.shopify_attributes }}>
          <div class="ph-holo-text">
            {%- if block.settings.title != blank -%}
              <h3 class="ph-holo-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="ph-holo-body">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
          <div class="ph-holo-card-wrap">
            <div class="ph-holo-card" tabindex="0">
              <div class="ph-holo-image-wrap">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag:
                    loading: 'lazy',
                    width: block.settings.image.width,
                    height: block.settings.image.height,
                    sizes: '(min-width: 990px) 600px, 90vw',
                    alt: block.settings.image.alt | default: block.settings.title
                  }}
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- else -%}
        {%- assign pos = block.settings.position -%}
        {%- if pos == 'right' -%}
          {%- assign pos_class = 'ph-block--right' -%}
        {%- elsif pos == 'left' -%}
          {%- assign pos_class = 'ph-block--left' -%}
        {%- else -%}
          {%- assign mod = forloop.index | modulo: 2 -%}
          {%- if mod == 0 -%}
            {%- assign pos_class = 'ph-block--right' -%}
          {%- else -%}
            {%- assign pos_class = 'ph-block--left' -%}
          {%- endif -%}
        {%- endif -%}

        <div class="ph-block {{ pos_class }}" {{ block.shopify_attributes }}>
          <div class="ph-block-image{% if block.settings.image == blank %} ph-block-image--empty{% endif %}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag:
                loading: 'lazy',
                width: block.settings.image.width,
                height: block.settings.image.height,
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: block.settings.image.alt | default: block.settings.title
              }}
            {%- else -%}
              <span>Imagen</span>
            {%- endif -%}
          </div>

          <div class="ph-block-text">
            {%- if block.settings.title != blank -%}
              <h3 class="ph-block-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="ph-block-body">
                {{ block.settings.body }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</section>

<script>
  (function () {
    'use strict';

    function init() {
      var section = document.getElementById('filosofia-{{ section.id }}');
      if (!section) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var cards = section.querySelectorAll('.ph-holo-card');

      cards.forEach(function ($card) {
        var bounds = null;

        function rotateToMouse(e) {
          if (!bounds) return;

          var mouseX = e.clientX;
          var mouseY = e.clientY;
          var leftX = mouseX - bounds.x;
          var topY = mouseY - bounds.y;
          var center = {
            x: leftX - bounds.width / 2,
            y: topY - bounds.height / 2
          };
          var distance = Math.sqrt(center.x * center.x + center.y * center.y);

          $card.style.transform =
            'scale3d(1.07, 1.07, 1.07) rotate3d(' +
              center.y / 100 + ', ' +
              -center.x / 100 + ', 0, ' +
              Math.log(distance) * 2 + 'deg)';

          $card.style.setProperty('--foil-x', (100 - (leftX / bounds.width) * 100) + '%');
          $card.style.setProperty('--foil-y', (100 - (topY / bounds.height) * 100) + '%');
        }

        function onEnter() {
          bounds = $card.getBoundingClientRect();
          document.addEventListener('mousemove', rotateToMouse);
        }

        function onLeave() {
          document.removeEventListener('mousemove', rotateToMouse);
          $card.style.transform = '';
          $card.style.removeProperty('--foil-x');
          $card.style.removeProperty('--foil-y');
          bounds = null;
          void $card.offsetWidth;
        }

        $card.addEventListener('mouseenter', onEnter);
        $card.addEventListener('mouseleave', onLeave);
        $card.addEventListener('focus', onEnter);
        $card.addEventListener('blur', onLeave);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% schema %}
{
  "name": "Nuestra Filosofía",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título de la sección",
      "default": "Nuestra Filosofía"
