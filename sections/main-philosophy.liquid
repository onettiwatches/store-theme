<style>
  #filosofia-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #filosofia-{{ section.id }} .ph-title-wrapper {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  #filosofia-{{ section.id }} .ph-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "img txt";
    gap: var(--space-6);
    align-items: center;
    max-width: var(--page-width, 1600px);
    margin: 0 auto var(--space-8);
    padding: 0 var(--space-4);
  }
  #filosofia-{{ section.id }} .ph-block:last-child {
    margin-bottom: 0;
  }
  #filosofia-{{ section.id }} .ph-block--left {
    grid-template-areas: "txt img";
  }
  #filosofia-{{ section.id }} .ph-block--right {
    grid-template-areas: "img txt";
  }
  #filosofia-{{ section.id }} .ph-block-image {
    grid-area: img;
  }
  #filosofia-{{ section.id }} .ph-block-text {
    grid-area: txt;
  }
  @media (max-width: 989px) {
    #filosofia-{{ section.id }} .ph-block,
    #filosofia-{{ section.id }} .ph-block--left,
    #filosofia-{{ section.id }} .ph-block--right {
      grid-template-columns: 1fr;
      grid-template-areas: "img" "txt";
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }
  }

  #filosofia-{{ section.id }} .ph-block-image {
    width: 100%;
    max-width: 36rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: rgba(var(--color-foreground), 0.04);
    justify-self: center;
  }
  @media (max-width: 989px) {
    #filosofia-{{ section.id }} .ph-block-image {
      max-width: 32rem;
      justify-self: center;
    }
  }
  #filosofia-{{ section.id }} .ph-block-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s var(--ease-out-quart);
  }
  #filosofia-{{ section.id }} .ph-block:hover .ph-block-image img {
    transform: scale(1.04);
  }
  #filosofia-{{ section.id }} .ph-block-image--empty {
    aspect-ratio: 4 / 3;
    border: 1px dashed rgba(var(--color-foreground), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #filosofia-{{ section.id }} .ph-block-image--empty span {
    color: rgba(var(--color-foreground), 0.4);
    font-family: var(--font-body-family);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #filosofia-{{ section.id }} .ph-block-text {
    grid-area: txt;
    text-align: left;
  }
  #filosofia-{{ section.id }} .ph-block-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  #filosofia-{{ section.id }} .ph-block-body {
    font-family: var(--font-body-family);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: rgba(var(--color-foreground), 0.78);
    margin: 0;
  }
  #filosofia-{{ section.id }} .ph-block-body p {
    margin: 0 0 var(--space-3);
  }
  #filosofia-{{ section.id }} .ph-block-body p:last-child {
    margin-bottom: 0;
  }

  #filosofia-{{ section.id }} .ph-holo {
    max-width: var(--page-width, 1600px);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }
  #filosofia-{{ section.id }} .ph-holo-container {
    perspective: 1000px;
    width: 100%;
    max-width: 22rem;
    margin: 0 auto;
  }
  #filosofia-{{ section.id }} .ph-holo-card {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    transform-style: preserve-3d;
    border-radius: 1rem;
    background:
      linear-gradient(
        135deg,
        rgba(var(--color-base-accent-2), 0.18) 0%,
        rgba(var(--color-base-accent-2), 0.04) 35%,
        rgba(var(--color-foreground), 0.04) 100%
      ),
      linear-gradient(
        180deg,
        rgba(var(--color-background), 0.6) 0%,
        rgba(var(--color-background), 0.95) 100%
      );
    border: 1px solid rgba(var(--color-base-accent-2), 0.35);
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(var(--color-foreground), 0.04) inset;
    transition: transform 0.15s var(--ease-out-quart);
    will-change: transform;
    cursor: pointer;
    overflow: hidden;
  }
  #filosofia-{{ section.id }} .ph-holo-card:focus-visible {
    outline: 0.2rem solid rgba(var(--color-base-accent-2), 0.7);
    outline-offset: 0.3rem;
  }

  #filosofia-{{ section.id }} .ph-holo-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: var(--space-4);
    text-align: center;
    color: rgb(var(--color-foreground));
  }

  #filosofia-{{ section.id }} .ph-holo-eyebrow {
    display: inline-block;
    font-family: var(--font-body-family);
    font-size: var(--text-xs);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: var(--font-body-weight-bold);
    color: rgb(var(--color-base-accent-2));
  }
  #filosofia-{{ section.id }} .ph-holo-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: 500;
    line-height: var(--lh-snug);
    margin: var(--space-1) 0 0;
    text-wrap: balance;
  }
  #filosofia-{{ section.id }} .ph-holo-subtitle {
    display: block;
    font-family: var(--font-body-family);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.65);
    margin-top: var(--space-1);
  }

  #filosofia-{{ section.id }} .ph-holo-image {
    flex: 1 1 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-3) 0;
    overflow: hidden;
  }
  #filosofia-{{ section.id }} .ph-holo-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }
  #filosofia-{{ section.id }} .ph-holo-image--empty {
    aspect-ratio: 1 / 1;
    border: 1px dashed rgba(var(--color-foreground), 0.2);
    border-radius: var(--radius-md);
  }
  #filosofia-{{ section.id }} .ph-holo-image--empty span {
    color: rgba(var(--color-foreground), 0.4);
    font-family: var(--font-body-family);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #filosofia-{{ section.id }} .ph-holo-meta {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding-top: var(--space-2);
    border-top: 1px solid rgba(var(--color-base-accent-2), 0.2);
    font-family: var(--font-body-family);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.75);
  }
  #filosofia-{{ section.id }} .ph-holo-meta-item {
    flex: 1 1 0;
  }

  #filosofia-{{ section.id }} .ph-holo-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 1;
    mix-blend-mode: overlay;
    opacity: 0.9;
    background-image: radial-gradient(
      circle at 50% 50%,
      #ffffff55,
      #0000000f
    );
    transition: opacity 0.3s var(--ease-out-quart);
  }
</style>

<section
  id="filosofia-{{ section.id }}"
  class="section color-background-1"
>
  <div class="ph-title-wrapper page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="title">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'holo_card' -%}
        <div class="ph-holo" {{ block.shopify_attributes }}>
          <div class="ph-holo-container">
            <div class="ph-holo-card" tabindex="0">
              <div class="ph-holo-content">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="ph-holo-eyebrow">{{ block.settings.eyebrow }}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="ph-holo-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <span class="ph-holo-subtitle">{{ block.settings.subtitle }}</span>
                {%- endif -%}

                <div class="ph-holo-image{% if block.settings.image == blank %} ph-holo-image--empty{% endif %}">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1200 | image_tag:
                      loading: 'lazy',
                      width: block.settings.image.width,
                      height: block.settings.image.height,
                      sizes: '(min-width: 990px) 360px, 80vw',
                      alt: block.settings.image.alt | default: block.settings.title
                    }}
                  {%- else -%}
                    <span>Imagen</span>
                  {%- endif -%}
                </div>

                {%- if block.settings.meta_left != blank or block.settings.meta_right != blank -%}
                  <div class="ph-holo-meta">
                    {%- if block.settings.meta_left != blank -%}
                      <span class="ph-holo-meta-item">{{ block.settings.meta_left }}</span>
                    {%- endif -%}
                    {%- if block.settings.meta_right != blank -%}
                      <span class="ph-holo-meta-item">{{ block.settings.meta_right }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              <div class="ph-holo-glow" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      {%- else -%}
        {%- assign pos = block.settings.position -%}
        {%- if pos == 'right' -%}
          {%- assign pos_class = 'ph-block--right' -%}
        {%- elsif pos == 'left' -%}
          {%- assign pos_class = 'ph-block--left' -%}
        {%- else -%}
          {%- assign mod = forloop.index | modulo: 2 -%}
          {%- if mod == 0 -%}
            {%- assign pos_class = 'ph-block--right' -%}
          {%- else -%}
            {%- assign pos_class = 'ph-block--left' -%}
          {%- endif -%}
        {%- endif -%}

        <div class="ph-block {{ pos_class }}" {{ block.shopify_attributes }}>
          <div class="ph-block-image{% if block.settings.image == blank %} ph-block-image--empty{% endif %}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag:
                loading: 'lazy',
                width: block.settings.image.width,
                height: block.settings.image.height,
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: block.settings.image.alt | default: block.settings.title
              }}
            {%- else -%}
              <span>Imagen</span>
            {%- endif -%}
          </div>

          <div class="ph-block-text">
            {%- if block.settings.title != blank -%}
              <h3 class="ph-block-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="ph-block-body">
                {{ block.settings.body }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</section>

{%- if section.blocks.size > 0 -%}
  <script>
    (function () {
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var section = document.getElementById('filosofia-{{ section.id }}');
      if (!section) return;

      var cards = section.querySelectorAll('.ph-holo-card');
      if (!cards.length) return;

      cards.forEach(function ($card) {
        var bounds = null;

        var rotateToMouse = function (e) {
          if (!bounds) return;

          var mouseX = e.clientX;
          var mouseY = e.clientY;
          var leftX = mouseX - bounds.x;
          var topY = mouseY - bounds.y;
          var center = {
            x: leftX - bounds.width / 2,
            y: topY - bounds.height / 2
          };
          var distance = Math.sqrt(center.x * center.x + center.y * center.y);

          $card.style.transform =
            'scale3d(1.07, 1.07, 1.07) rotate3d(' +
              center.y / 100 + ', ' +
              -center.x / 100 + ', 0, ' +
              Math.log(distance) * 2 + 'deg)';

          var glow = $card.querySelector('.ph-holo-glow');
          if (glow) {
            glow.style.backgroundImage =
              'radial-gradient(' +
                'circle at ' +
                (center.x * 2 + bounds.width / 2) + 'px ' +
                (center.y * 2 + bounds.height / 2) + 'px, ' +
                '#ffffff55, #0000000f)';
          }
        };

        var handleMouseEnter = function () {
          bounds = $card.getBoundingClientRect();
          document.addEventListener('mousemove', rotateToMouse);
        };

        var handleMouseLeave = function () {
          document.removeEventListener('mousemove', rotateToMouse);
          $card.style.transform = '';
          var glow = $card.querySelector('.ph-holo-glow');
          if (glow) glow.style.backgroundImage = '';
          bounds = null;
        };

        $card.addEventListener('mouseenter', handleMouseEnter);
        $card.addEventListener('mouseleave', handleMouseLeave);
        $card.addEventListener('focus', handleMouseEnter);
        $card.addEventListener('blur', handleMouseLeave);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Nuestra Filosofía",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título de la sección",
      "default": "Nuestra Filosofía"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Párrafo con imagen",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Selección de componentes"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Párrafo",
          "default": "<p>Cada pieza se elige cuidadosamente para garantizar calidad, ajuste y durabilidad real.</p>"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Posición de la imagen",
          "options": [
            { "value": "alternating", "label": "Intercalada (auto)" },
            { "value": "right", "label": "Derecha (texto izquierda)" },
            { "value": "left", "label": "Izquierda (texto derecha)" }
          ],
          "default": "alternating",
          "info": "En modo auto, alterna: 1ª derecha, 2ª izquierda, 3ª derecha."
        }
      ]
    },
    {
      "type": "holo_card",
      "name": "Tarjeta holográfica",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen principal"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Etiqueta superior",
          "default": "Edición limitada"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Submarine GMT"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo",
          "default": "Referencia 001 / 100"
        },
        {
          "type": "text",
          "id": "meta_left",
          "label": "Meta izquierda",
          "default": "42 mm"
        },
        {
          "type": "text",
          "id": "meta_right",
          "label": "Meta derecha",
          "default": "300 m"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Nuestra Filosofía",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Componentes de alta gama",
            "body": "<p>Seleccionamos piezas de proveedores suizos y japoneses reconocidos, eligiendo cada componente por su fiabilidad demostrada y su comportamiento a largo plazo.</p>",
            "position": "alternating"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Montaje manual y ajuste individual",
            "body": "<p>Cada reloj se ensambla a mano en nuestro taller. El ajuste de precisión se realiza individualmente para asegurar una marcha estable y exacta desde el primer día.</p>",
            "position": "alternating"
          }
        },
        {
          "type": "holo_card",
          "settings": {
            "eyebrow": "Edición limitada",
            "title": "Submarine GMT",
            "subtitle": "Referencia 001 / 100",
            "meta_left": "42 mm",
            "meta_right": "300 m"
          }
        }
      ]
    }
  ]
}
{% endschema %}
